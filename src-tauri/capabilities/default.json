{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for k-agent main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "store:default",
    "allow-list",
    "allow-save",
    "allow-delete",
    "allow-refresh",
    "allow-refresh-single",
    "allow-window-minimize",
    "allow-window-toggle-maximize",
    "allow-window-is-maximized",
    "allow-window-close"
  ]
}
