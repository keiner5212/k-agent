{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for k-agent main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "store:default",
    "dialog:default",
    "dialog:allow-open",
    "allow-list",
    "allow-save",
    "allow-delete",
    "allow-refresh",
    "allow-refresh-single",
    "allow-upsert-model",
    "allow-delete-model",
    "allow-set-favorite",
    "allow-set-minimize-to-tray",
    "allow-get-minimize-to-tray",
    "allow-window-minimize",
    "allow-window-toggle-maximize",
    "allow-window-is-maximized",
    "allow-window-close",
    "allow-window-get-bounds",
    "allow-window-apply-bounds",
    "allow-window-start-resize",
    "allow-window-start-drag",
    "allow-window-open-devtools",
    "allow-list-system-fonts",
    "allow-list-skills",
    "allow-read-skill-meta",
    "allow-read-skill-file",
    "allow-create-skill",
    "allow-update-skill",
    "allow-update-skill-content",
    "allow-delete-skill",
    "allow-list-agents",
    "allow-list-agents-md",
    "allow-write-agents-md",
    "allow-delete-agents-md",
    "allow-read-agent-meta",
    "allow-create-agent",
    "allow-update-agent",
    "allow-delete-agent",
    "allow-get-workspace-path",
    "allow-set-workspace-path",
    "allow-get-repo-info",
    "allow-list-language-servers",
    "allow-install-language-server",
    "allow-uninstall-language-server",
    "allow-resolve-language-server",
    "allow-lsp-request"
  ]
}
