{
  "tasks": {
    "dev": "deno run --allow-net --allow-read --allow-env --allow-run --watch=apps/desktop apps/desktop/main.ts",
    "start": "deno run --allow-net --allow-read --allow-env --allow-run apps/desktop/main.ts",
    "compile": "deno compile --allow-net --allow-read --allow-env --allow-run -o bin/k-agent apps/desktop/main.ts",
    "check": "deno check apps/ packages/",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint",
    "test": "deno test"
  },
  "imports": {
    "hono": "jsr:@hono/hono@^4.13.3",
    "hono/deno": "jsr:@hono/hono@^4.13.3/deno",
    "@std/path": "jsr:@std/path@^1.0.0",
    "webview": "npm:webview@^1.1.0",
    "@shared/": "./packages/shared/"
  },
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.window", "dom"]
  },
  "lint": {
    "include": ["apps/", "packages/"],
    "exclude": ["bin/", "apps/desktop/public/"],
    "rules": {
      "tags": ["recommended"]
    }
  },
  "fmt": {
    "include": ["apps/", "packages/"],
    "exclude": ["bin/", "apps/desktop/public/"],
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": false,
    "semiColons": true
  }
}