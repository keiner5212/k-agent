{
  "name": "k-agent",
  "private": true,
  "version": "0.2.4",
  "type": "module",
  "description": "AI coding model orchestrator desktop app",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=22.13",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "changelog": "node scripts/changelog.mjs",
    "tauri": "tauri",
    "dev:tauri": "K_AGENT_FOREGROUND=1 tauri dev",
    "build:tauri": "tauri build",
    "bundle:mermaid-check": "node node_modules/esbuild/bin/esbuild scripts/mermaid-check.mjs --bundle --platform=node --format=cjs --outfile=src-tauri/resources/mermaid-check.cjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "2.5.0",
    "@tauri-apps/plugin-dialog": "2.8.3",
    "@tauri-apps/plugin-notification": "2.7.0",
    "@tauri-apps/plugin-opener": "2.7.2",
    "@tauri-apps/plugin-store": "2.5.0",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "i18next": "26.4.0",
    "lucide-react": "1.33.0",
    "marked": "^18.1.2",
    "mermaid": "^12.2.0",
    "modern-screenshot": "4.7.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.12",
    "use-stick-to-bottom": "1.1.6",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.12.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.4",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "6.1.0",
    "esbuild": "^0.28.2",
    "eslint": "10.9.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.11.0",
    "happy-dom": "^21.0.4",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.4",
    "vitest": "^4.1.12"
  }
}
