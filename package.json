{
  "name": "k-agent",
  "version": "0.0.0",
  "private": true,
  "description": "Desktop AI agent orchestrator. Deno + Hono + WebView + Next.js (static export).",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:desktop": "pnpm --filter desktop dev",
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build:web": "pnpm --filter web build",
    "build:desktop": "pnpm --filter desktop build",
    "build": "pnpm -r build",
    "sync:web": "node scripts/sync-web.mjs",
    "lint": "pnpm --filter \"./packages/*\" --filter \"./apps/*\" lint",
    "clean": "pnpm --filter \"./packages/*\" --filter \"./apps/*\" exec rm -rf node_modules .next out dist .deno_build"
  }
}